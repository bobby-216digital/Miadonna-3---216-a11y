{% comment %}
  Pause/play toggle for a looping background video.

  Accepts:
  - controls: {String} space-separated ids of the video element(s) it controls

  Usage:
  {% render 'video-toggle-button', controls: 'video-id' %}
{% endcomment %}
<button
  type="button"
  class="media-video-toggle"
  aria-controls="{{ controls }}"
  aria-pressed="false"
  aria-label="Pause video"
>
